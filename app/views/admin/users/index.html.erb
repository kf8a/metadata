<h2>Users</h2>
<p>
  <%= link_to 'Add a user', new_admin_user_path %> ·
  <%= link_to 'Download permissions', permissions_path %>
</p>

<%= form_with url: admin_users_path, method: :get do |form| %>
  <%= form.label :q, 'Find' %>
  <%= form.search_field :q, value: @query, placeholder: 'email, name or institution' %>
  <%= form.submit 'Search', name: nil %>
<% end %>

<table class='users'>
  <tr>
    <th>Email</th>
    <th>Name</th>
    <th>Institution</th>
    <th>Role</th>
    <th>Memberships</th>
    <th>Status</th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= link_to user.email, edit_admin_user_path(user) %></td>
      <td><%= user.name %></td>
      <td><%= user.institution %></td>
      <td><%= user.role %></td>
      <td><%= user.sponsors.map(&:name).sort.join(', ') %></td>
      <td><%= user_status(user) %></td>
    </tr>
  <% end %>
</table>
<% if @users.empty? %>
  <p>No users<%= " match #{@query}" if @query.present? %>.</p>
<% end %>
