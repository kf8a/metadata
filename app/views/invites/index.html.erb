<h1>Listing invites</h1>

<table>
  <tr>
  </tr>

<% @invites.each do |invite| %>
  <tr>
    <td><%= "#{invite.firstname} #{invite.lastname}"%></td>
    <td><%= link_to 'Send Invite', send_invitation_path(invite), data: { turbo_confirm: 'Send invitation?' } %></td>
    <td><%= link_to 'Show', invite %></td>
    <td><%= link_to 'Edit', edit_invite_path(invite) %></td>
    <td><%= link_to 'Destroy', invite, data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New invite', new_invite_path %>