<li id="abstract_<%= abstract.id %>" class = 'citation'>
  <%= truncate(abstract.authors, length: 80) %>
  <%= abstract.title %>
  <%= link_to "abstract", abstract_path(abstract) %>
  <% if abstract.pdf.attached? %>
    <%=link_to abstract.meeting_abstract_type.name.downcase , download_abstract_path(abstract) %>
  <% end %>

  <% if admin? %>
    <%= link_to 'Edit', edit_abstract_path(abstract) %>
    <%= link_to image_tag('trash.gif', alt: 'Delete'), abstract_path(abstract),
      data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
  <% end %>
</li>
