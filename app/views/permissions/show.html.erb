<h2>Permissions for <%= @datatable.name %></h2>
<p><%= link_to @datatable.title, datatable_path(@datatable) %></p>
<p><%= link_to 'Grant permission to someone', new_permission_path(datatable: @datatable) %></p>

<h3>Requests</h3>
<% if @pending_requests.empty? %>
  <p>No pending requests.</p>
<% end %>
<% @pending_requests.each do |request| %>
  <div class='permission-request'>
    <%= request.user.email %> has asked to download this datatable
    <% if request.created_at %>
      <time datetime='<%= request.created_at.iso8601 %>' title='<%= request.created_at.to_date.to_fs(:long) %>'>
        <%= time_ago_in_words(request.created_at) %> ago
      </time>.
    <% else %>.
    <% end %>
    <%= button_to "Grant for #{Permission::DEFAULT_LIFETIME.in_days.to_i} days", permissions_path,
                  params: { datatable: @datatable.id, email: request.user.email } %>
    <%= button_to 'Dismiss', dismiss_permission_path(@datatable), method: :delete,
                  params: { user: request.user_id },
                  form: { data: { turbo_confirm: "Dismiss the request from #{request.user.email}?" } } %>
  </div>
<% end %>

<h3>People with access</h3>
<% if @permissions.empty? %>
  <p>Nobody has been granted access.</p>
<% else %>
  <table class='permissions'>
    <tr>
      <th>Account</th>
      <th>Intended use</th>
      <th>Granted by</th>
      <th>First granted</th>
      <th>Access until</th>
      <th></th>
    </tr>
    <% @permissions.each do |permission| %>
      <tr class='<%= 'expired' unless permission.active? %>'>
        <td>
          <%= permission.user.email %>
          <% if permission.user.name %><br><%= permission.user.name %>, <%= permission.user.institution %><% end %>
          <% if permission.user.invited_to_sign_up? %><br><em>Has not set a password yet; extending resends the link</em><% end %>
        </td>
        <td><%= permission.intended_use %></td>
        <td><%= permission.granted_by&.email %></td>
        <td>
          <% if permission.created_at %>
            <time datetime='<%= permission.created_at.iso8601 %>' title='<%= permission.created_at.to_date.to_fs(:long) %>'>
              <%= time_ago_in_words(permission.created_at) %> ago
            </time>
          <% end %>
        </td>
        <td>
          <% if permission.expires_on.nil? %>
            No expiry
          <% elsif permission.active? %>
            <%= permission.expires_on.to_fs(:long) %>
          <% else %>
            Expired on <%= permission.expires_on.to_fs(:long) %>
          <% end %>
        </td>
        <td>
          <%= button_to "Extend #{Permission::DEFAULT_LIFETIME.in_days.to_i} days from today", permissions_path,
                        params: { datatable: @datatable.id, email: permission.user.email } %>
          <%= button_to 'Revoke', permission_path(@datatable), method: :delete,
                        params: { user: permission.user_id },
                        form: { data: { turbo_confirm: "Revoke access for #{permission.user.email}?" } } %>
        </td>
      </tr>
    <% end %>
  </table>
  <p>Expired permissions are removed <%= Permission::KEEP_EXPIRED_FOR.in_days.to_i %> days after they expire.</p>
<% end %>
