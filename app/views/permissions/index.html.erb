<h2>Download permissions</h2>
<p>Restricted and members-only datatables. The owners agree to a request by email; grant it here.</p>

<table class='permissions'>
  <tr>
    <th>Datatable</th>
    <th>Pending requests</th>
    <th>People with access</th>
  </tr>
  <% @datatables.each do |datatable| %>
    <tr>
      <td><%= link_to datatable.name, permission_path(datatable) %> <%= datatable.title %></td>
      <td><%= datatable.pending_requesters.size %></td>
      <td><%= datatable.permissions.active.count %></td>
    </tr>
  <% end %>
</table>
